---
import Layout from "../../../../../layouts/Layout.astro";
import StructCode from "../../../../../components/StructCode.astro";
import ContextBar from "../../../../../components/ContextBar.astro";
import { catalog, rendererFor, usedInFor, slugNames, slug } from "../../../../../lib/render.mjs";

export function getStaticPaths() {
  const out = [];
  for (const d of catalog().docs) {
    for (const name of slugNames(d)) {
      out.push({
        params: { arch: d.arch, build: d.build, module: d.module, type: slug(name) },
        props: { name },
      });
    }
  }
  return out;
}

const { arch, build, module } = Astro.params;
const { name } = Astro.props;
const doc = catalog().get(arch, build, module);
const r = rendererFor(doc);
const layout = r.paholeLayout(name);
const enumLayout = layout ? null : r.enumLayout(name);
const used = usedInFor(doc)[name] || [];
---
<Layout title={`${name} · ${module} ${build}`} side>
  <ContextBar arch={arch} build={build} module={module} type={name} />
  <StructCode layout={layout} enumLayout={enumLayout} />
  {used.length > 0 && (
    <section class="used">
      <div class="used-h">Used in ({used.length})</div>
      <div class="used-list">{used.map((x) => (<a href={`${slug(x)}.html`}>{x}</a>))}</div>
    </section>
  )}
</Layout>
