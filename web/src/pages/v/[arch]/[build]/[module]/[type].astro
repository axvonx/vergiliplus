---
import Layout from "../../../../../layouts/Layout.astro";
import ContextBar from "../../../../../components/ContextBar.astro";
import { catalog, cmpBuild, usedInFor, typeList, ctxPath } from "../../../../../lib/catalog.mjs";
import { slug } from "../../../../../lib/types.mjs";
import { fragmentOf } from "../../../../../lib/panel.mjs";

export function getStaticPaths() {
  const out = [];
  for (const d of catalog().docs) {
    for (const it of typeList(d)) {
      out.push({
        params: { arch: d.arch, build: d.build, module: d.module, type: it.s },
        props: { name: it.n, opaque: it.o, kind: it.k },
      });
    }
  }
  return out;
}

const { arch, build, module } = Astro.params;
const { name, opaque, kind } = Astro.props;
const cat = catalog();
const doc = cat.get(arch, build, module);
const used = usedInFor(doc)[name] || [];

let frag = null, definedIn = [];
if (opaque) {
  // where this name does have a layout: other modules of this build first, then other builds
  definedIn = cat.docs
    .filter((d) => d.arch === arch && name in d.named)
    .map((d) => ({ d, here: d.build === build }))
    .sort((x, y) => (y.here - x.here) || cmpBuild(y.d.build, x.d.build) || (x.d.module < y.d.module ? -1 : 1));
} else {
  frag = `/f/${fragmentOf(doc, name)}.html`;  // shared panel, injected by struct.js
}
---
<Layout title={`${name} · ${module} ${build}`} side>
  <ContextBar arch={arch} build={build} module={module} type={name} />
  {opaque ? (
    <div class="panel">
      <pre class="sc-pre"><code><div class="sc-line"><span class="sc-code"><span class="kw">{kind}</span> {name};</span><span class="sc-ann">/* opaque */</span></div></code></pre>
      <p class="opaque-note">
        Declared but not defined in <b>{module}</b>'s public PDB for this build: a forward
        declaration, or a name that only appears in mangled C++ symbols. The layout isn't public here.
      </p>
      {definedIn.length > 0 && (
        <div class="defined-in">Defined in: {definedIn.map(({ d }) => (
          <a href={`${ctxPath(d.arch, d.build, d.module)}/${slug(name)}.html`}>{d.module} {d.build}</a>
        ))}</div>
      )}
    </div>
  ) : (
    <div class="panel" data-frag={frag}><noscript>The layout loads with JavaScript: <a href={frag}>plain view</a>.</noscript></div>
  )}
  {used.length > 0 && (
    <section class="panel">
      <div class="used-h">Used in ({used.length})</div>
      <div class="used-list">{used.map((x) => (<a href={`${slug(x)}.html`}>{x}</a>))}</div>
    </section>
  )}
</Layout>
