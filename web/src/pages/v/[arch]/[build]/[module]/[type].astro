---
import Layout from "../../../../../layouts/Layout.astro";
import StructCode from "../../../../../components/StructCode.astro";
import ContextBar from "../../../../../components/ContextBar.astro";
import { catalog, typesFor, usedInFor, slugNames } from "../../../../../lib/catalog.mjs";
import { slug } from "../../../../../lib/types.mjs";
import { structLayout, enumLayout as enumOf } from "../../../../../lib/layout.mjs";

export function getStaticPaths() {
  const out = [];
  for (const d of catalog().docs) {
    for (const name of slugNames(d)) {
      out.push({
        params: { arch: d.arch, build: d.build, module: d.module, type: slug(name) },
        props: { name },
      });
    }
  }
  return out;
}

const { arch, build, module } = Astro.params;
const { name } = Astro.props;
const doc = catalog().get(arch, build, module);
const T = typesFor(doc);
const layout = structLayout(T, name);
const enumLayout = layout ? null : enumOf(T, name);
const used = usedInFor(doc)[name] || [];
const plural = (n, w) => `${n} ${w}${n === 1 ? "" : "s"}`;
const s = layout?.summary;
const stats = enumLayout
  ? [[plural(enumLayout.summary.values, "value"), ""], ["size", enumLayout.summary.size]]
  : [["size", `${s.size} (0x${s.size.toString(16)})`], [plural(s.members, "member"), ""],
     [plural(s.holes, "hole"), s.holes ? `${s.sumHoles} bytes` : ""], ["padding", s.padding],
     [plural(s.cachelines, "cacheline"), ""]];
---
<Layout title={`${name} · ${module} ${build}`} side>
  <ContextBar arch={arch} build={build} module={module} type={name} />
  <StructCode layout={layout} enumLayout={enumLayout} named={doc.named} />
  <div class="stats">
    {stats.map(([k, v]) => /^\d/.test(k)
      ? <span><b>{k.split(" ")[0]}</b> {k.split(" ").slice(1).join(" ")}{v !== "" ? ` (${v})` : ""}</span>
      : <span>{k} <b>{v}</b></span>)}
  </div>
  {used.length > 0 && (
    <section class="used">
      <div class="used-h">Used in ({used.length})</div>
      <div class="used-list">{used.map((x) => (<a href={`${slug(x)}.html`}>{x}</a>))}</div>
    </section>
  )}
</Layout>
