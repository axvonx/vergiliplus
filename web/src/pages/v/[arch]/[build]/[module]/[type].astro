---
import Docs from "../../../../../layouts/Docs.astro";
import StructCode from "../../../../../components/StructCode.jsx";
import VersionBar from "../../../../../components/VersionBar.astro";
import { catalog, rendererFor, usedInFor, slugNames, slug, ctxPath, MODLABEL } from "../../../../../lib/render.mjs";

export function getStaticPaths() {
  const out = [];
  for (const d of catalog().docs) {
    for (const name of slugNames(d)) {
      out.push({
        params: { arch: d.arch, build: d.build, module: d.module, type: slug(name) },
        props: { name },
      });
    }
  }
  return out;
}

const { arch, build, module } = Astro.params;
const { name } = Astro.props;
const doc = catalog().get(arch, build, module);
const r = rendererFor(doc);
const layout = r.paholeLayout(name);
const plain = r.paholeText(name);
const used = usedInFor(doc)[name] || [];
const refs = layout
  ? [...new Map(layout.rows.filter((x) => x.reflink).map((x) => [x.reflink, x.ref])).entries()]
      .map(([s, n]) => ({ s, n })).sort((a, b) => a.n.localeCompare(b.n))
  : [];
const s = layout?.summary;
const hex = (n) => "0x" + n.toString(16);
---
<Docs title={`${name} · ${module} ${build}`}>
  <div class="breadcrumbs-col">
    <nav><ol class="breadcrumb">
      <li class="breadcrumb-item"><a class="breadcrumb-link" href="/">Versions</a></li>
      <li class="breadcrumb-item"><a class="breadcrumb-link" href={`${ctxPath(arch, build, module)}.html`}>{module} {build}</a></li>
      <li class="breadcrumb-item active">{name}</li>
    </ol></nav>
  </div>
  <h2 class="h2-tdata">{name}</h2>
  <VersionBar arch={arch} build={build} module={module} type={name} />

  {layout ? (
    <StructCode layout={layout} plain={plain} client:visible />
  ) : (
    <pre class="sc-pre"><code><div class="sc-line" set:html={r.toplevel(name)} /></code></pre>
  )}

  <Fragment slot="rail">
    {s && (
      <div>
        <div class="rail-h">Layout</div>
        <div class="rail-stat"><span>size</span><b>{hex(s.size)} ({s.size})</b></div>
        <div class="rail-stat"><span>members</span><b>{s.members}</b></div>
        <div class="rail-stat"><span>holes</span><b>{s.holes} ({s.sumHoles}b)</b></div>
        <div class="rail-stat"><span>padding</span><b>{s.padding}</b></div>
        <div class="rail-stat"><span>cachelines</span><b>{s.cachelines}</b></div>
      </div>
    )}
    <div>
      <div class="rail-h">Version</div>
      <div class="rail-stat"><span>module</span><b>{module} ({MODLABEL[module]})</b></div>
      <div class="rail-stat"><span>build</span><b>{build}</b></div>
      <div class="rail-stat"><span>defined in</span><b>{catalog().typeBuilds(arch, module, name).length} builds</b></div>
    </div>
    {refs.length > 0 && (
      <div>
        <div class="rail-h">References ({refs.length})</div>
        {refs.map((x) => (<a class="rail-link" href={`${x.s}.html`}>{x.n}</a>))}
      </div>
    )}
    {used.length > 0 && (
      <div>
        <div class="rail-h">Used in ({used.length})</div>
        {used.map((x) => (<a class="rail-link" href={`${slug(x)}.html`}>{x}</a>))}
      </div>
    )}
  </Fragment>
</Docs>
