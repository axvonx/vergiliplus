---
// Module type list: context bar, the build's sources (where its layouts don't come from a
// public PDB: doc.sources, collapsed; the context bar's tags link here), then a filter
// row (text + kind chips with counts) over an auto-fit, colour-coded column list.
// Filtering is in nav.js. "named" = names only a checked build's ASSERT text gives.
import Layout from "../../../../layouts/Layout.astro";
import ContextBar from "../../../../components/ContextBar.astro";
import { catalog, typeList, TAGS } from "../../../../lib/catalog.mjs";
import { typePath } from "../../../../lib/panel.mjs";

export function getStaticPaths() {
  return catalog().docs.map((d) => ({
    params: { arch: d.arch, build: d.build, module: d.module },
  }));
}

const { arch, build, module } = Astro.params;
const doc = catalog().get(arch, build, module);
const items = typeList(doc);
const names = items.map((it) => it.n);
const counts = { all: items.length, struct: 0, union: 0, enum: 0, opaque: 0, named: 0 };
for (const it of items) it.a ? counts.named++ : it.o ? counts.opaque++ : counts[it.k]++;
if (!counts.named) delete counts.named;
const srcs = doc.sources || [];
const file = (u) => decodeURIComponent(u).split("/").pop();
// size columns to the 90th-percentile name (the long tail ellipsizes, full name in
// the tooltip) so wide screens get many columns instead of a few sized to the longest
const lens = names.map((n) => n.length).sort((a, b) => a - b);
const colCh = Math.max(20, lens[Math.floor(lens.length * 0.9)] || 20) + 3;
---
<Layout title={`${module} ${doc.buildLabel || build}`} wide>
  <ContextBar arch={arch} build={build} module={module} />
  {srcs.length > 0 && (
    <details class="srcs" id="sources">
      <summary>Sources{doc.incomplete && <span class="srcs-gap"> · {doc.incomplete}</span>}</summary>
      <ul>{srcs.map((s) => (
        <li><span class={`tag t-${s.tag}`} title={TAGS[s.tag]}>{s.tag}</span>
          <div><span class="srcs-cite">{s.cite}</span><span class="srcs-note">{s.note}</span>
            {s.check && <span class="srcs-check">✓ {s.check}</span>}
            <a class="srcs-url" href={s.url}>{file(s.url)}</a></div></li>))}</ul>
      <p class="srcs-about">How each kind of source works: <a href="/about.html">about</a>.</p>
    </details>
  )}
  <div class="tl-top" data-tl-ctrl>
    <input class="tl-filter" placeholder="filter types…" />
    {Object.entries(counts).map(([k, n]) => (
      <button class={`btn kind-btn${k === "all" ? " on" : ""}`} data-k={k}>{k} {n}</button>
    ))}
  </div>
  <div class="hz-list" data-tl style={`column-width:${Math.round(colCh * 1.2)}ch`}>
    {items.map((it) => (
      <a class={`hz k-${it.k}${it.o ? " op" : ""}${it.a ? " nm" : ""}`} href={`${typePath(arch, module, it.n)}#${build}`} title={it.n.length + 3 > colCh ? it.n : undefined}><span class="dot"></span>{it.n}</a>
    ))}
  </div>
</Layout>
