---
// Module type list: context bar, then a filter row (text + kind chips with counts)
// over an auto-fit, colour-coded column list. Filtering is in nav.js.
import Layout from "../../../../layouts/Layout.astro";
import ContextBar from "../../../../components/ContextBar.astro";
import { catalog, rendererFor, slugNames, slug, ctxPath } from "../../../../lib/render.mjs";

export function getStaticPaths() {
  return catalog().docs.map((d) => ({
    params: { arch: d.arch, build: d.build, module: d.module },
  }));
}

const { arch, build, module } = Astro.params;
const doc = catalog().get(arch, build, module);
const r = rendererFor(doc);
const names = slugNames(doc);
const items = names.map((n) => ({ n, k: r.get(doc.named[n]).kind, s: slug(n) }));
const counts = { all: items.length, struct: 0, union: 0, enum: 0 };
for (const it of items) counts[it.k]++;
const maxLen = Math.max(...names.map((n) => n.length));
const base = ctxPath(arch, build, module);
---
<Layout title={`${module} ${build}`}>
  <ContextBar arch={arch} build={build} module={module} />
  <div class="tl-top" data-tl-ctrl>
    <input class="tl-filter" placeholder="filter types…" />
    {Object.entries(counts).map(([k, n]) => (
      <button class={`btn kind-btn${k === "all" ? " on" : ""}`} data-k={k}>{k} {n}</button>
    ))}
  </div>
  <div class="hz-list" data-tl style={`column-width:${maxLen + 3}ch`}>
    {items.map((it) => (
      <a class={`hz k-${it.k}`} href={`${base}/${it.s}.html`}><span class="dot"></span>{it.n}</a>
    ))}
  </div>
</Layout>
