---
// Home: one row per Windows version, newest first, colour-coded by channel.
// A row links to the version page (no-JS fallback); nav.js retargets it to the
// module last viewed for that build, else the kernel.
import Layout from "../layouts/Layout.astro";
import { catalog, cmpBuild, versionPath, channel, modInfo } from "../lib/render.mjs";
const cat = catalog();
const seen = new Set();
const versions = cat.docs.slice().sort((a, b) => cmpBuild(b.build, a.build))
  .filter((d) => { const k = d.arch + "/" + d.build; return !seen.has(k) && seen.add(k); })
  .map((d) => {
    const mods = cat.modules(d.arch, d.build);
    const kernel = mods.includes("ntoskrnl") ? "ntoskrnl" : mods.find((m) => modInfo(m).ring === "kernel") || mods[0];
    return { ...d, mods, kernel };
  });
const multiArch = cat.archs().length > 1;
---
<Layout>
  <ul class="vlist">
    {versions.map((v) => (
      <li><a class={`vrow ch-${channel(v.family)}`} href={versionPath(v.arch, v.build)}
             data-ab={`${v.arch}/${v.build}`} data-mods={v.mods.join(",")} data-def={v.kernel}>
        <span class="vr-fam">{v.family}</span>
        <span class="vr-build">{v.build}{multiArch ? ` · ${v.arch}` : ""}</span>
      </a></li>
    ))}
  </ul>
</Layout>
