---
import Base from "../layouts/Base.astro";
import { catalog, cmpBuild, ctxPath } from "../lib/render.mjs";
const docs = catalog().docs.slice().sort((a, b) => cmpBuild(b.build, a.build));
const groups = [
  { label: "Userland", module: "ntdll" },
  { label: "Kernel", module: "ntoskrnl" },
].map((g) => ({ ...g, docs: docs.filter((d) => d.module === g.module) }))
 .filter((g) => g.docs.length > 0);
const total = docs.reduce((n, d) => n + Object.keys(d.named).length, 0);
---
<Base title="versions">
  <h1 class="page-title">Versions</h1>
  <p class="subtle">
    {docs.length} module builds · {total.toLocaleString()} documented types, from public PDBs.
    Press <span class="kbd">⌘K</span> to search everything.
  </p>
  {groups.map((g) => (
    <>
      <div class="mod-h">{g.label} <span class="mod-n">{g.module} · {g.docs.length} builds</span></div>
      <div class="ver-grid">
        {g.docs.map((d) => (
          <a class="ver-card" href={`${ctxPath(d.arch, d.build, d.module)}.html`}>
            <span class="vc-count">{Object.keys(d.named).length} types</span>
            <span class="vc-build">{d.build}</span>
            <span class="vc-fam">{d.family} · {d.arch}</span>
          </a>
        ))}
      </div>
    </>
  ))}
</Base>
