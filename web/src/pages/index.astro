---
// Home: one row per Windows version, newest first, colour-coded by channel.
// A row links to the build's kernel listing; nav.js retargets it to the module
// last viewed for that build.
import Layout from "../layouts/Layout.astro";
import { catalog, ctxPath, channel } from "../lib/catalog.mjs";
import { modInfo } from "../lib/modules.mjs";
const cat = catalog();
const versions = cat.versions().map((d) => {
    const mods = cat.modules(d.arch, d.build);
    const kernel = mods.includes("ntoskrnl") ? "ntoskrnl" : mods.find((m) => modInfo(m).ring === "kernel") || mods[0];
    return { ...d, mods, kernel };
  });
const multiArch = cat.archs().length > 1;
---
<Layout>
  <ul class="vlist">
    {versions.map((v) => (
      <li><a class={`vrow ch-${channel(v.family)}`} href={`${ctxPath(v.arch, v.build, v.kernel)}.html`}
             data-ab={`${v.arch}/${v.build}`} data-mods={v.mods.join(",")} data-def={v.kernel}>
        <span class="vr-fam">{v.family}</span>
        <span class="vr-build">{v.build}{multiArch ? ` · ${v.arch}` : ""}</span>
      </a></li>
    ))}
  </ul>
</Layout>
