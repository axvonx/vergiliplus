---
import { catalog, ctxPath, slug, modInfo } from "../lib/render.mjs";
const { arch, build, module, type } = Astro.props;
const cat = catalog();
const fam = (b, m = module) => cat.get(arch, b, m)?.family || "";
const typeHref = (b, m = module) => `${ctxPath(arch, b, m)}/${slug(type)}.html`;
const listHref = (b, m = module) => `${ctxPath(arch, b, m)}.html`;

const mods = cat.modules(arch, build);
const builds = cat.builds(arch, module);
const has = type ? new Set(cat.typeBuilds(arch, module, type)) : null;

let prev = null, next = null;
if (type) {
  const tb = cat.typeBuilds(arch, module, type);
  const i = tb.indexOf(build);
  prev = i > 0 ? tb[i - 1] : null;
  next = i >= 0 && i < tb.length - 1 ? tb[i + 1] : null;
}
---
<div class="vbar">
  <span class="vb-arch">{arch}</span>
  <span class="vb-mods">
    {mods.map((m) => {
      const inOther = type && cat.get(arch, build, m)?.named[type];
      const info = modInfo(m);
      return m === module
        ? <span class={`vb-mod on r-${info.ring}`}>{info.label}</span>
        : <a class={`vb-mod r-${info.ring}`} href={inOther ? typeHref(build, m) : listHref(build, m)}
             title={inOther ? `${type} in ${info.label}` : info.label}>{info.label}</a>;
    })}
  </span>
  {/* option value = build; the page's URL shape is rebuilt client-side (keeps ~28k pages lean) */}
  <select class="vb-build" aria-label="Build" data-t={type ? `/v/${arch}/@/${module}/${slug(type)}.html` : ""}
    data-l={`/v/${arch}/@/${module}.html`}
    onchange="var o=this.selectedOptions[0];location.href=(o.dataset.n||!this.dataset.t?this.dataset.l:this.dataset.t).replace('@',this.value)">
    {builds.map((b) => (
      <option value={b} selected={b === build} data-n={type && !has.has(b) ? "1" : undefined}>
        {fam(b)} — {b}{type && !has.has(b) ? "  (not defined)" : ""}
      </option>
    ))}
  </select>
  {type && (
    <span class="vb-step">
      {prev ? <a href={typeHref(prev)} title={`${fam(prev)} ${prev}`}>← {prev}</a> : <span class="vb-off">← first</span>}
      <span class="vb-n">{has.size} build{has.size === 1 ? "" : "s"}</span>
      {next ? <a href={typeHref(next)} title={`${fam(next)} ${next}`}>{next} →</a> : <span class="vb-off">latest →</span>}
    </span>
  )}
</div>
