---
// Static pahole-style struct/union/enum view. All interactivity (Metadata toggle,
// copy, row click-through) lives in /assets/struct.js via document-level delegation,
// so the page carries the layout exactly once — no island props.
import { esc, html } from "../lib/types.mjs";
import { offAnn, hexv } from "../lib/layout.mjs";
const { layout, enumLayout, named } = Astro.props;
const IND = "    ";
const ind = (d) => IND.repeat(d + 1);

function rowHtml(r) {
  if (r.hole != null)
    return `<div class="sc-line sc-hole"><span class="sc-code">${ind(r.depth)}/* ${r.hole} byte${r.hole === 1 ? "" : "s"} padding */</span></div>`;
  if (r.cacheline != null)
    return `<div class="sc-line sc-cache"><span class="sc-code">${ind(r.depth)}/* ── cacheline ${r.cacheline} boundary (${r.bytes} bytes) ── */</span></div>`;
  if (r.open)
    return `<div class="sc-line sc-grp"><span class="sc-code">${ind(r.depth)}<span class="kw">${r.open}</span> {</span></div>`;
  if (r.close)
    return `<div class="sc-line sc-grp"><span class="sc-code">${ind(r.depth)}}${r.field ? ` <span class="sc-field">${esc(r.field)}</span>` : ""};</span><span class="sc-ann">/* 0x${r.offset.toString(16)}  ${r.size} */</span></div>`;
  const bits = r.bits != null ? ` : ${r.bits}` : "";
  return `<div class="sc-member k-${r.fkind}${r.linked ? " link" : ""}"><span class="sc-code">${ind(r.depth)}${html(r.typePre, named)}${r.sep}<span class="sc-field">${esc(r.field)}</span>${html(r.typeSuf, named)}${bits};</span><span class="sc-ann">/* ${offAnn(r)} */</span></div>`;
}

let head, body;
if (enumLayout) {
  head = `<span class="kw">enum</span> ${esc(enumLayout.name)} {`;
  body = enumLayout.values.map((v) =>
    `<div class="sc-member k-enum"><span class="sc-code">${IND}${esc(v.name)} = ${v.value},</span><span class="sc-ann">/* ${hexv(v.value)} */</span></div>`).join("");
} else {
  head = `<span class="kw">${layout.kind}</span> ${esc(layout.name)} {`;
  body = layout.rows.map(rowHtml).join("");
}
---
<div class="sc" data-sc>
  <pre class="sc-pre"><code><div class="sc-ctrls"><button class="sc-tgl" data-sc-meta aria-pressed="true"><span class="sc-box"></span>Metadata</button><button class="sc-copy" data-sc-copy>copy</button></div><div class="sc-line sc-head"><span class="sc-code" set:html={head} /></div><Fragment set:html={body} /><div class="sc-line"><span class="sc-code">{"};"}</span></div></code></pre>
</div>
