---
// Where am I + where can I go, in one row (replaces breadcrumbs, the type heading,
// the old version bar and the sidebar header):
//   [arch]  build ▾  /  module | module  /  Type        ← prev · n builds · next →
// On a listing the build is the page's. On a type page (`page` from lib/panel.mjs) it
// is the URL's #<build>: this renders the default build and nav.js re-syncs the select,
// steps and module links when struct.js switches builds (vp:build).
import { catalog, ctxPath } from "../lib/catalog.mjs";
import { modInfo } from "../lib/modules.mjs";
import { typePath } from "../lib/panel.mjs";
const { arch, build, module, type, page } = Astro.props;
const cat = catalog();
const fam = (b) => cat.get(arch, b, module)?.family || "";
const lab = (b) => cat.get(arch, b, module)?.buildLabel || b;
const inc = (b) => !!cat.get(arch, b, module)?.incomplete;
const listHref = (b, m = module) => `${ctxPath(arch, b, m)}.html`;
const multiArch = cat.archs().length > 1;

const mods = cat.modules(arch, build);
const builds = cat.builds(arch, module);
// a type page's steps: the builds it appears in (defined or opaque)
const tb = page ? builds.filter((_, i) => page.has[i] !== "-") : [];
const i = tb.indexOf(build);
const prev = i > 0 ? tb[i - 1] : null;
const next = i >= 0 && i < tb.length - 1 ? tb[i + 1] : null;
// other modules: their page for this type where they have one (any build)
const inMod = (m) => page && catalog().docs.some((d) => d.arch === arch && d.module === m && (type in d.named || type in d.opaque));
---
<div class="cbar">
  {multiArch && <span class="cb-arch">{arch}</span>}
  {/* Only the current build is rendered; nav.js fills the rest from /builds.json
      (one copy, not ~2 KB in every page). data-has has one char per build of
      cat.builds(arch, module): d defined, o opaque, - absent. On a listing, picking a
      build loads its listing (data-l, @ = build); on a type page it sets #<build>,
      or loads that build's listing where the type is absent. */}
  <select class="cb-build" aria-label="Build" data-am={`${arch}/${module}`}
    data-has={page ? page.has : undefined} data-tsel={page ? "1" : undefined} data-l={`/v/${arch}/@/${module}.html`}>
    <option value={build} selected class={inc(build) ? "inc" : undefined}>{fam(build)} — {lab(build)}{inc(build) ? "  (incomplete)" : ""}{page && page.has[builds.indexOf(build)] === "o" ? "  (opaque)" : ""}</option>
  </select>
  <span class="cb-sep">/</span>
  <span class="cb-mods">
    {mods.map((m) => {
      const label = modInfo(m).label;
      if (m === module) return <span class="cb-mod on">{label}</span>;
      const other = inMod(m);
      return <a class="cb-mod" href={other ? `${typePath(arch, m, type)}#${build}` : listHref(build, m)}
                data-mod={m} data-tpage={other ? "1" : undefined}
                title={other ? `${type} in ${label}` : label}>{label}</a>;
    })}
  </span>
  {type && <span class="cb-sep">/</span>}
  {type && <h1 class="cb-type">{type}</h1>}
  {page && (
    <span class="cb-step" data-step>
      {prev ? <a href={`#${prev}`} title={`${fam(prev)} ${lab(prev)}`}>← {lab(prev)}</a> : <span class="off">← first</span>}
      <span class="n">{tb.length} build{tb.length === 1 ? "" : "s"}</span>
      {next ? <a href={`#${next}`} title={`${fam(next)} ${lab(next)}`}>{lab(next)} →</a> : <span class="off">latest →</span>}
    </span>
  )}
</div>
