---
const { side = false } = Astro.props;
---
<nav class="navbar navbar-expand-lg navbar-light bg-dark">
  {side && (
    <button class="side-toggle" title="Toggle sidebar"
      onclick="document.documentElement.classList.toggle('side-collapsed');try{localStorage.setItem('vp-side',document.documentElement.classList.contains('side-collapsed')?'0':'1')}catch(e){}">☰</button>
  )}
  <a class="navbar-brand" href="/">vergili<span class="plus">plus</span></a>
  <ul class="navbar-nav mr-auto flex-row">
    <li class="nav-item"><a class="nav-link" href="/">VERSIONS</a></li>
  </ul>
  <button class="sb-kind" style="margin-left:auto" onclick="vpCmdK()">Search&nbsp;<span class="kbd">⌘K</span></button>
</nav>
<div id="vp-ck" class="ck-ov" hidden><div class="ck">
  <input class="ck-input" placeholder="Search every type in every build…  (↑↓ ↵ esc)" />
  <div class="ck-list"></div>
</div></div>
