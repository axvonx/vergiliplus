---
// The one page shell. `side` adds the persisted type sidebar (type pages);
// `wide` drops the centred max-width (type listings: as many columns as fit).
// Behaviour lives in /assets/nav.js + struct.js: vanilla, cached once, no islands.
import { ClientRouter } from "astro:transitions";
const { title, side = false, wide = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · vergiliplus` : "vergiliplus"}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/site.css" />
    <ClientRouter />
    <script is:inline>try{document.documentElement.classList.toggle("side-collapsed",localStorage.getItem("vp-side")==="0")}catch(e){}</script>
    <script is:inline src="/assets/nav.js"></script>
    <script is:inline src="/assets/struct.js"></script>
  </head>
  <body>
    <nav class="topnav">
      {side && <button class="side-toggle" title="Toggle sidebar" data-side-toggle>☰</button>}
      <a class="brand" href="/"><img class="logo" src="/logo.svg" alt="" width="46" height="46" /><span>vergili<span class="plus">plus</span></span></a>
      <button class="navlink" data-cmdk title="Search ( / or ⌘K )">Search</button>
    </nav>
    <div id="vp-ck" class="ck-ov" hidden><div class="ck">
      <input class="ck-input" placeholder="Search every type in every build…" />
      <div class="ck-filters"></div>
      <div class="ck-list"></div>
      <div class="ck-foot">↑↓ move · ↵ open · click a square for that build · esc close · / or ⌘K to open</div>
    </div></div>
    {side ? (
      <div class="docs">
        <aside class="docs-side" transition:persist>
          <div class="sb" id="vp-sb">
            <div class="sb-top">
              <input class="sb-filter" placeholder="filter types…" />
              <div class="sb-kinds">
                <button class="btn on" data-k="all">all</button><button class="btn" data-k="struct">S</button><button class="btn" data-k="union">U</button><button class="btn" data-k="enum">E</button><button class="btn" data-k="opaque">O</button>
              </div>
            </div>
            <div class="sb-count"></div>
            <nav class="sb-list"></nav>
          </div>
        </aside>
        <main class="docs-main"><slot /></main>
      </div>
    ) : (
      <main class={wide ? "page wide" : "page"}><slot /></main>
    )}
    <footer class="foot">
      Layouts from Microsoft's public symbols · look after the <a href="https://www.vergiliusproject.com">Vergilius Project</a> · <a href="https://github.com/axvonx/vergiliplus">source</a> (MIT)
    </footer>
  </body>
</html>
