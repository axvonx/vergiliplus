---
import { ClientRouter } from "astro:transitions";
import Chrome from "../components/Chrome.astro";
import TopNav from "../components/TopNav.astro";
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <Chrome title={title}>
    <Fragment slot="head">
      <ClientRouter />
      <script is:inline>
        try { if (localStorage.getItem("vp-side") === "0") document.documentElement.classList.add("side-collapsed"); } catch (e) {}
      </script>
    </Fragment>
  </Chrome>
  <body>
    <TopNav side />
    <div class="docs">
      <aside class="docs-side" transition:persist>
        <div class="sb" id="vp-sb">
          <a class="sb-ctx" href="/"></a>
          <div class="sb-top">
            <input class="sb-filter" placeholder="filter types…" />
            <div class="sb-kinds">
              <button class="sb-kind on" data-k="all">all</button><button class="sb-kind" data-k="struct">S</button><button class="sb-kind" data-k="union">U</button><button class="sb-kind" data-k="enum">E</button>
            </div>
          </div>
          <div class="sb-count"></div>
          <nav class="sb-list"></nav>
        </div>
      </aside>
      <main class="docs-main">
        <slot />
        <div class="meta-bottom"><slot name="rail" /></div>
      </main>
    </div>
    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        try { document.documentElement.classList.toggle("side-collapsed", localStorage.getItem("vp-side") === "0"); } catch (e) {}
      });
    </script>
  </body>
</html>
